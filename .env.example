# Copy this file to .env.local (which is gitignored) and fill in real values.
# Never commit an actual key.

# Server-side only — used by src/lib/googlePlaces.ts and the
# /api/venue-photo route. Deliberately NOT prefixed with NEXT_PUBLIC_, so it
# is never bundled into client-side JavaScript. See the setup steps in the
# project notes for how to create and restrict this key.
GOOGLE_PLACES_API_KEY=

# More tab forms (Suggest a Place, Give Feedback, Contact Us). Server-side only.
# RESEND_API_KEY: create at resend.com -> API Keys (starts with "re_").
# SUBMISSIONS_TO_EMAIL: the inbox that receives submissions.
# SUBMISSIONS_FROM_EMAIL (optional): defaults to Resend's testing sender,
#   "KnowaPlace <onboarding@resend.dev>".
RESEND_API_KEY=
SUBMISSIONS_TO_EMAIL=
SUBMISSIONS_FROM_EMAIL=
