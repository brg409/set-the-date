# Copy this file to .env.local (which is gitignored) and fill in real values.
# Never commit an actual key.

# Server-side only — used by src/lib/googlePlaces.ts and the
# /api/venue-photo route. Deliberately NOT prefixed with NEXT_PUBLIC_, so it
# is never bundled into client-side JavaScript. See the setup steps in the
# project notes for how to create and restrict this key.
GOOGLE_PLACES_API_KEY=
